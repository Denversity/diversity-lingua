# Copier en .env (à la racine ou dans backend/). NE JAMAIS committer .env.
DL_ENV=dev                      # dev | prod  (prod : désactive langue de test, fixtures et fournisseur simulé)
DL_ALLOW_TEST_DATA=true         # false en production

# Ordre de priorité des fournisseurs (premier résultat valide gagné)
DL_PROVIDER_ORDER=memory,glossary,openai_compat,anthropic,nllb,mock   # mémoire validée → glossaire validé → moteurs

# Sécurité
DL_API_TOKEN=                   # si défini, l'extension doit l'envoyer (X-DL-Token)
DL_ADMIN_TOKEN=                 # requis pour POST /api/v1/glossary/validate (validateurs)
DL_RATE_LIMIT_PER_MIN=240

# Moteur IA compatible OpenAI (OpenAI, Azure, vLLM, Ollama…) — laisser vide si non utilisé
DL_OPENAI_BASE_URL=https://api.openai.com/v1
DL_OPENAI_API_KEY=
DL_OPENAI_MODEL=

# Moteur Anthropic — laisser vide si non utilisé
DL_ANTHROPIC_API_KEY=
DL_ANTHROPIC_MODEL=

# Modèle local (NLLB…) : licence CC-BY-NC pour NLLB-200 → vérifier l'usage avant d'activer
DL_NLLB_MODEL=
DL_LOCAL_MODEL_LICENSE_ACK=false

DL_ALLOW_MACHINE_TRANSLATION=true
DL_SHOW_PENDING=false           # true : afficher les traductions humaines « pending_validation » (jamais comme approuvées)
DL_PROVIDER_TIMEOUT_S=20
DL_LOG_LEVEL=INFO
