{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noUncheckedIndexedAccess": false, "skipLibCheck": true, "resolveJsonModule": true,
    "types": ["chrome", "node"], "noEmit": true, "isolatedModules": true
  },
  "include": ["src", "tests"]
}
